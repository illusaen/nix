#!/usr/bin/env sh
set -eu

usage() {
  cat <<'USAGE'
usage: bin/deploy [--plan|--dry-run|--build|--apply] [--on] TARGET

Targets:
  HOST       Deploy one host.
  @all       Select every host.
  @nixos     Select every NixOS host.
  @darwin    Select every Darwin host.
  @TAG       Select hosts whose fleet tags include TAG.

Deploy NixOS hosts through Colmena and Darwin hosts through nix-darwin.
USAGE
}

mode=apply

while [ "$#" -gt 0 ]; do
  case "$1" in
    --plan)
      mode=plan
      shift
      ;;
    --dry-run)
      mode=dry-run
      shift
      ;;
    --build|--build-only)
      mode=build
      shift
      ;;
    --apply)
      mode=apply
      shift
      ;;
    --on)
      shift
      break
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

target="${1:-}"
if [ -z "$target" ]; then
  usage >&2
  exit 2
fi

case "$target" in
  *[!A-Za-z0-9_@:.+-]*)
    printf 'invalid target selector: %s\n' "$target" >&2
    exit 2
    ;;
esac

eval_expr() {
  nix --extra-experimental-features nix-command eval --impure --raw --expr "$1"
}

colmena_nix_config() {
  if [ -n "${NIX_CONFIG:-}" ]; then
    printf '%s\nabort-on-warn = false\n' "$NIX_CONFIG"
  else
    printf '%s\n' 'abort-on-warn = false'
  fi
}

colmena_cmd() {
  NIX_CONFIG="$(colmena_nix_config)" colmena "$@"
}

select_hosts() {
  eval_expr "let api = import ./default.nix; in builtins.concatStringsSep \"\n\" (api.deploy.selectHostNames \"$target\")"
}

platform_for() {
  eval_expr "let api = import ./default.nix; in api.hosts.\"$1\".platform"
}

target_host_for() {
  eval_expr "let api = import ./default.nix; in api.hosts.\"$1\".targetHost"
}

is_local_target() {
  host="$1"
  target_host="$(target_host_for "$host")"
  short_hostname="$(hostname 2>/dev/null || true)"
  fqdn_hostname="$(hostname -f 2>/dev/null || true)"

  case "$target_host" in
    localhost|127.0.0.1|::1)
      return 0
      ;;
  esac

  if [ "$target_host" = "$host" ]; then
    return 0
  fi

  if [ -n "$short_hostname" ] && [ "$target_host" = "$short_hostname" ]; then
    return 0
  fi

  if [ -n "$fqdn_hostname" ] && [ "$target_host" = "$fqdn_hostname" ]; then
    return 0
  fi

  return 1
}

current_system_path() {
  readlink -f /run/current-system 2>/dev/null || printf '%s\n' /run/current-system
}

diff_system_build() {
  host="$1"
  old_path="$2"
  new_path="$3"

  if ! is_local_target "$host"; then
    printf 'skipping dix diff for remote target: %s (%s)\n' "$host" "$(target_host_for "$host")"
    return 0
  fi

  if ! command -v dix >/dev/null 2>&1; then
    printf 'skipping dix diff because dix is not in PATH\n' >&2
    return 0
  fi

  if [ ! -e "$old_path" ]; then
    printf 'skipping dix diff because old system path does not exist: %s\n' "$old_path" >&2
    return 0
  fi

  if [ ! -e "$new_path" ]; then
    printf 'skipping dix diff because new system path does not exist: %s\n' "$new_path" >&2
    return 0
  fi

  printf 'dix diff for %s: %s -> %s\n' "$host" "$old_path" "$new_path"
  if ! dix "$old_path" "$new_path"; then
    printf 'dix diff failed for %s\n' "$host" >&2
  fi
}

build_nixos_toplevel() {
  host="$1"
  nix-build --no-out-link --expr "let api = import ./default.nix; configs = api.hostLib.mkNixosConfigurations { inherit (api) fleet sources; }; in configs.\"$host\".config.system.build.toplevel"
}

plan_host() {
  host="$1"
  platform="$(platform_for "$host")"
  target_host="$(target_host_for "$host")"
  printf '%s\t%s\t%s\t%s\n' "$mode" "$host" "$platform" "$target_host"
}

deploy_nixos() {
  host="$1"
  case "$mode" in
    plan)
      plan_host "$host"
      ;;
    dry-run)
      colmena_cmd -f hive.nix apply --eval-node-limit 1 --on "$host" --dry-run
      ;;
    build)
      colmena_cmd -f hive.nix build --eval-node-limit 1 --on "$host"
      result="$(build_nixos_toplevel "$host")"
      diff_system_build "$host" "$(current_system_path)" "$result"
      ;;
    apply)
      old_system="$(current_system_path)"
      colmena_cmd -f hive.nix apply --eval-node-limit 1 --on "$host"
      diff_system_build "$host" "$old_system" /run/current-system
      ;;
  esac
}

deploy_darwin() {
  host="$1"
  attr="${host}.config.system.build.toplevel"
  case "$mode" in
    plan)
      plan_host "$host"
      ;;
    dry-run|build)
      result="$(nix-build darwin.nix -A "$attr")"
      if [ "$mode" = build ]; then
        diff_system_build "$host" "$(current_system_path)" "$result"
      fi
      ;;
    apply)
      old_system="$(current_system_path)"
      result="$(nix-build darwin.nix -A "$attr")"
      if [ -x "$result/activate-user" ]; then
        "$result/activate-user"
      fi
      if [ ! -x "$result/activate" ]; then
        printf 'darwin activation script not found for %s at %s/activate\n' "$host" "$result" >&2
        exit 1
      fi
      "$result/activate"
      diff_system_build "$host" "$old_system" "$result"
      ;;
  esac
}

hosts="$(select_hosts)"
if [ "$mode" = plan ]; then
  printf 'mode\thost\tplatform\ttargetHost\n'
fi

if [ -z "$hosts" ]; then
  if [ "$mode" = plan ]; then
    exit 0
  fi

  printf 'target selected no hosts: %s\n' "$target" >&2
  exit 1
fi

for host in $hosts; do
  platform="$(platform_for "$host")"
  case "$platform" in
    nixos)
      deploy_nixos "$host"
      ;;
    darwin)
      deploy_darwin "$host"
      ;;
    *)
      printf 'unsupported host platform: %s (%s)\n' "$host" "$platform" >&2
      exit 1
      ;;
  esac
done
