#!/usr/bin/env sh
set -eu

usage() {
  cat <<'USAGE'
usage: bin/deploy [--dry-run|--build] HOST

Deploy NixOS hosts through Colmena and Darwin hosts through nix-darwin.
USAGE
}

mode=apply
case "${1:-}" in
  --dry-run)
    mode=dry-run
    shift
    ;;
  --build)
    mode=build
    shift
    ;;
  -h|--help)
    usage
    exit 0
    ;;
esac

host="${1:-}"
if [ -z "$host" ]; then
  usage >&2
  exit 2
fi

platform="$(
  nix-instantiate --eval --strict --json default.nix -A "hosts.${host}.platform" 2>/dev/null \
    | tr -d '"'
)"

case "$platform:$mode" in
  nixos:dry-run)
    exec colmena -f hive.nix apply --eval-node-limit 1 --on "$host" --dry-run
    ;;
  nixos:build)
    exec colmena -f hive.nix build --eval-node-limit 1 --on "$host"
    ;;
  nixos:apply)
    exec colmena -f hive.nix apply --eval-node-limit 1 --on "$host"
    ;;
  darwin:dry-run|darwin:build)
    exec nix-build darwin.nix -A "${host}.system"
    ;;
  darwin:apply)
    printf '%s\n' "darwin apply is not wired yet; build first with: bin/deploy --build $host" >&2
    exit 1
    ;;
  *)
    printf 'unsupported host or mode: %s (%s)\n' "$host" "$platform" >&2
    exit 1
    ;;
esac
