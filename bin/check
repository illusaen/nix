#!/usr/bin/env sh
set -eu

nix-instantiate --eval --strict default.nix -A checks.fleet >/dev/null
nix-instantiate --eval --strict default.nix -A checks.routedServices >/dev/null
nix-instantiate --eval --strict default.nix -A checks.featureClosure >/dev/null
nix-instantiate --eval --strict default.nix -A checks.hostFeaturesExist >/dev/null
nix-instantiate --eval --strict default.nix -A checks.hostFeaturesHavePlatformModules >/dev/null
nix-instantiate --eval --strict default.nix -A checks.serviceFeaturesExist >/dev/null
nix-instantiate --eval --strict default.nix -A checks.serviceFeaturesHaveNixosModules >/dev/null
nix-instantiate --eval --strict default.nix -A checks.hostPublicKeysExist >/dev/null
nix-instantiate --parse hive.nix >/dev/null
nix-instantiate --parse darwin.nix >/dev/null

printf '%s\n' 'plain Nix migration checks passed'
