#!/usr/bin/env sh
set -eu

check() {
  name="$1"
  value="$(nix-instantiate --eval --strict default.nix -A "checks.$name")"

  if [ "$value" != true ]; then
    printf 'plain Nix migration check failed: %s = %s\n' "$name" "$value" >&2
    exit 1
  fi
}

check fleet
check routedServices
check featureClosure
check hostFeaturesExist
check hostFeaturesHavePlatformModules
check serviceFeaturesExist
check serviceFeaturesHaveNixosModules
check hostPublicKeysExist
check serviceSecretsDeclared
check serviceSecretRecipientsCoverRoutedHosts
check serviceRoutingComplete
check servicePortsDoNotConflict
check deploySelectors
check unitTests

nix-instantiate --parse hive.nix >/dev/null
nix-instantiate --parse darwin.nix >/dev/null

printf '%s\n' 'plain Nix migration checks passed'
